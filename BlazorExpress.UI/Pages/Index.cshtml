@page
@model IndexModel
@inject Microsoft.Extensions.Options.IOptions<LibraryVersionsOptions> LibraryVersionsOptions
@{
    ViewData["Title"] = "Blazor Component Libraries";
    var versions = LibraryVersionsOptions.Value;
    var chartJsVersion = string.IsNullOrWhiteSpace(versions.ChartJs) ? string.Empty : $"v{versions.ChartJs}";
    var bulmaVersion = string.IsNullOrWhiteSpace(versions.Bulma) ? string.Empty : $"v{versions.Bulma}";
}

<section id="top" class="landing-hero mb-4 mb-lg-5 fade-up">
    <div class="hero-shell rounded-5 p-4 p-lg-5 shadow-sm overflow-hidden">
        <div class="row g-4 align-items-center">
            <div class="col-lg-7">
                <span class="badge rounded-pill hero-badge mb-3">Built for modern Blazor teams</span>
                <h1 class="display-4 fw-semibold mb-3">Enterprise-grade, production-ready Blazor component libraries.</h1>
                <p class="lead text-body-secondary mb-4">BlazorExpress brings our released libraries into one place so teams can evaluate fit, compare capabilities, and move directly to docs, demos, source, or NuGet.</p>
                <div class="d-flex flex-column flex-sm-row gap-3 mb-4">
                    <a class="btn btn-primary btn-lg px-4" href="#libraries">View libraries</a>
                    <a class="btn btn-outline-secondary btn-lg px-4" href="#releases">Release highlights</a>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4 p-lg-5">
                        <p class="small text-uppercase fw-semibold text-body-tertiary mb-2">Available now</p>
                        <h2 class="h3 mb-4">Released libraries.</h2>
                        <div class="d-grid gap-3">
                            <a class="simple-link-card text-decoration-none" href="https://chartjs.blazorexpress.com/" target="_blank" rel="noreferrer">
                                <span>
                                    <span class="d-block fw-semibold text-dark">BlazorExpress.ChartJS</span>
                                    <span class="small text-body-secondary">Our charting library for Blazor dashboards, reports, and data-heavy screens.</span>
                                </span>
                                <span class="badge rounded-pill bg-info-subtle text-info-emphasis border border-info-subtle">@chartJsVersion</span>
                            </a>
                            <a class="simple-link-card text-decoration-none" href="https://bulma.blazorexpress.com/" target="_blank" rel="noreferrer">
                                <span>
                                    <span class="d-block fw-semibold text-dark">BlazorExpress.Bulma</span>
                                    <span class="small text-body-secondary">Our Bulma-based component library for forms, dialogs, and layout work.</span>
                                </span>
                                <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis border border-warning-subtle">@bulmaVersion</span>
                            </a>
                        </div>
                        <hr class="my-4" />
                        <p class="text-body-secondary mb-0">Each library includes documentation, demos, package feeds, and source.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="libraries" class="py-4 py-lg-5">
    <div class="row justify-content-center text-center mb-4">
        <div class="col-xl-8 fade-up fade-delay-1">
            <span class="badge rounded-pill text-bg-light border text-dark mb-3">Libraries</span>
            <h2 class="display-6 fw-semibold mb-3">Focused libraries we actively ship.</h2>
            <p class="lead text-body-secondary mb-0">Each library has a clear purpose, current version, and direct links to documentation and packages.</p>
        </div>
    </div>
    <div class="row row-cols-1 row-cols-xl-2 g-4">
        <div class="col d-flex">
            <article class="card border-0 shadow-sm hover-lift w-100 fade-up fade-delay-1">
                <div class="card-body p-4 p-lg-5">
                    <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                        <div>
                            <span class="badge rounded-pill section-badge mb-2">Charting</span>
                            <h3 class="h2 mb-2">BlazorExpress.ChartJS</h3>
                            <p class="text-body-secondary mb-0">Chart components for dashboards, reports, and analytics-heavy Blazor screens.</p>
                        </div>
                        <span class="badge rounded-pill bg-info-subtle text-info-emphasis border border-info-subtle">@chartJsVersion</span>
                    </div>
                    <div class="simple-detail-grid mb-4">
                        <div class="simple-detail rounded-4 p-3">
                            <p class="small text-uppercase fw-semibold text-body-tertiary mb-2">Includes</p>
                            <p class="mb-0">Bar, Line, Pie, Radar, Scatter.</p>
                        </div>
                        <div class="simple-detail rounded-4 p-3">
                            <p class="small text-uppercase fw-semibold text-body-tertiary mb-2">Best for</p>
                            <p class="mb-0">Reporting, monitoring, and data visualization workflows.</p>
                        </div>
                    </div>
                    <div class="library-actions mb-3" role="group" aria-label="ChartJS links">
                        <a class="btn btn-primary" href="https://chartjs.blazorexpress.com/docs/getting-started/introduction" target="_blank" rel="noreferrer">Docs</a>
                        <a class="btn btn-outline-primary" href="https://chartjs.blazorexpress.com/demos/bar-chart" target="_blank" rel="noreferrer">Demos</a>
                        <a class="btn btn-outline-primary" href="https://www.nuget.org/packages/BlazorExpress.ChartJS" target="_blank" rel="noreferrer">NuGet</a>
                        <a class="btn btn-outline-primary" href="https://chartjs.blazorexpress.com/" target="_blank" rel="noreferrer">Site</a>
                        <a class="btn btn-outline-primary" href="https://github.com/BlazorExpress/BlazorExpress.ChartJS" target="_blank" rel="noreferrer">GitHub</a>
                    </div>
                </div>
            </article>
        </div>
        <div class="col d-flex">
            <article class="card border-0 shadow-sm hover-lift w-100 fade-up fade-delay-2">
                <div class="card-body p-4 p-lg-5">
                    <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                        <div>
                            <span class="badge rounded-pill section-badge mb-2">UI</span>
                            <h3 class="h2 mb-2">BlazorExpress.Bulma</h3>
                            <p class="text-body-secondary mb-0">Bulma-based components for forms, dialogs, layout, and day-to-day application UI.</p>
                        </div>
                        <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis border border-warning-subtle">@bulmaVersion</span>
                    </div>
                    <div class="simple-detail-grid mb-4">
                        <div class="simple-detail rounded-4 p-3">
                            <p class="small text-uppercase fw-semibold text-body-tertiary mb-2">Includes</p>
                            <p class="mb-0">Dropdown, Navbar, NumberInput, PdfViewer, Dialogs.</p>
                        </div>
                        <div class="simple-detail rounded-4 p-3">
                            <p class="small text-uppercase fw-semibold text-body-tertiary mb-2">Best for</p>
                            <p class="mb-0">Admin screens, form workflows, and general application layout.</p>
                        </div>
                    </div>
                    <div class="library-actions mb-3" role="group" aria-label="Bulma links">
                        <a class="btn btn-primary" href="https://bulma.blazorexpress.com/docs/getting-started/introduction" target="_blank" rel="noreferrer">Docs</a>
                        <a class="btn btn-outline-primary" href="https://bulma.blazorexpress.com/demos/skeletons" target="_blank" rel="noreferrer">Demos</a>
                        <a class="btn btn-outline-primary" href="https://www.nuget.org/packages/BlazorExpress.Bulma/" target="_blank" rel="noreferrer">NuGet</a>
                        <a class="btn btn-outline-primary" href="https://bulma.blazorexpress.com/" target="_blank" rel="noreferrer">Site</a>
                        <a class="btn btn-outline-primary" href="https://github.com/BlazorExpress/BlazorExpress.Bulma" target="_blank" rel="noreferrer">GitHub</a>
                    </div>
                </div>
            </article>
        </div>
    </div>
</section>

<section id="releases" class="py-4 py-lg-5">
    <div class="row justify-content-center text-center mb-4">
        <div class="col-xl-8 fade-up fade-delay-1">
            <span class="badge rounded-pill text-bg-light border text-dark mb-3">Release highlights</span>
            <h2 class="display-6 fw-semibold mb-3">Recent improvements across both libraries.</h2>
            <p class="lead text-body-secondary mb-0">A concise view of the most important updates without repeating the full library details.</p>
        </div>
    </div>
    <div class="row g-4 align-items-stretch justify-content-center">
        <div class="col-lg-4 d-flex">
            <div class="card border-0 shadow-sm w-100 fade-up fade-delay-1">
                <div class="card-body p-4">
                    <p class="small text-uppercase fw-semibold text-body-tertiary mb-2">ChartJS</p>
                    <h3 class="h4 mb-3">Cleaner charts and stronger LineChart support.</h3>
                    <p class="text-body-secondary mb-0">Recent work focused on styling consistency, added LineChart options, and clearer documentation.</p>
                </div>
            </div>
        </div>
        <div class="col-lg-4 d-flex">
            <div class="card border-0 shadow-sm w-100 fade-up fade-delay-2">
                <div class="card-body p-4">
                    <p class="small text-uppercase fw-semibold text-body-tertiary mb-2">Bulma</p>
                    <h3 class="h4 mb-3">New navigation, input, and viewer components.</h3>
                    <p class="text-body-secondary mb-0">Recent work expanded the library with Dropdown, Navbar, NumberInput, and PdfViewer components.</p>
                </div>
            </div>
        </div>
    </div>
</section>
