@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<section id="top" class="py-4 py-lg-5">
    <div class="card border-0 shadow-lg overflow-hidden text-bg-primary bg-gradient">
        <div class="card-body p-4 p-lg-5">
            <div class="row g-4 g-xl-5 align-items-center">
                <div class="col-lg-7">
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <img src="https://chartjs.blazorexpress.com/_content/BlazorExpress.ChartJS.Demo.RCL/icons/logo.png" alt="BlazorExpress logo" width="64" height="64" class="rounded-4 bg-white p-2 shadow-sm" />
                        <div>
                            <span class="badge rounded-pill text-bg-light text-primary mb-2">blazorexpress.com</span>
                            <p class="small text-uppercase fw-semibold text-white-50 mb-0">Open-source component libraries for focused Blazor UI stacks</p>
                        </div>
                    </div>
                    <h1 class="display-3 fw-bold lh-sm mb-3">BlazorExpress is the hub for our specialized component libraries, releases, and live demos.</h1>
                    <p class="lead text-white-50 mb-4">From ChartJS integrations to Bulma-powered UI building blocks, the main site now highlights what is shipping across the BlazorExpress ecosystem and gives each library a direct path to docs, demos, GitHub, and NuGet.</p>
                    <div class="d-flex flex-column flex-sm-row gap-3 mb-4">
                        <a class="btn btn-light btn-lg px-4" href="#libraries">Explore libraries</a>
                        <a class="btn btn-outline-light btn-lg px-4" href="#releases">Latest releases</a>
                    </div>
                    <div class="row row-cols-1 row-cols-sm-3 g-3">
                        <div class="col">
                            <div class="card h-100 border-0 bg-white bg-opacity-10 text-white shadow-sm">
                                <div class="card-body">
                                    <p class="small text-uppercase fw-semibold text-white-50 mb-2">Live sites</p>
                                    <p class="h5 mb-0">ChartJS and Bulma</p>
                                </div>
                            </div>
                        </div>
                        <div class="col">
                            <div class="card h-100 border-0 bg-white bg-opacity-10 text-white shadow-sm">
                                <div class="card-body">
                                    <p class="small text-uppercase fw-semibold text-white-50 mb-2">Current releases</p>
                                    <p class="h5 mb-0">v1.2.1 and v1.1.0</p>
                                </div>
                            </div>
                        </div>
                        <div class="col">
                            <div class="card h-100 border-0 bg-white bg-opacity-10 text-white shadow-sm">
                                <div class="card-body">
                                    <p class="small text-uppercase fw-semibold text-white-50 mb-2">Discovery path</p>
                                    <p class="h5 mb-0">Docs, demos, GitHub, NuGet</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-5">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-4 p-lg-5 text-dark">
                            <div class="d-flex justify-content-between align-items-start mb-4">
                                <div>
                                    <p class="small text-uppercase text-body-secondary fw-semibold mb-2">Ecosystem snapshot</p>
                                    <h2 class="h3 mb-0">Two focused libraries, one BlazorExpress home</h2>
                                </div>
                                <span class="badge text-bg-success">Live</span>
                            </div>
                            <div class="list-group list-group-flush border rounded-3 mb-4">
                                <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3" href="https://chartjs.blazorexpress.com/" target="_blank" rel="noreferrer">
                                    <span>
                                        <span class="d-block fw-semibold">BlazorExpress.ChartJS</span>
                                        <span class="small text-body-secondary">Charts, utilities, and live demos</span>
                                    </span>
                                    <span class="badge text-bg-primary">v1.2.1</span>
                                </a>
                                <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3" href="https://bulma.blazorexpress.com/" target="_blank" rel="noreferrer">
                                    <span>
                                        <span class="d-block fw-semibold">BlazorExpress.Bulma</span>
                                        <span class="small text-body-secondary">Form, layout, and dialog components</span>
                                    </span>
                                    <span class="badge text-bg-primary">v1.1.0</span>
                                </a>
                            </div>
                            <div class="row row-cols-1 row-cols-sm-2 g-3">
                                <div class="col">
                                    <div class="border rounded-3 h-100 p-3">
                                        <p class="small text-uppercase text-body-secondary fw-semibold mb-2">Release view</p>
                                        <p class="mb-0">Surface what shipped, what improved, and where each library lives.</p>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="border rounded-3 h-100 p-3">
                                        <p class="small text-uppercase text-body-secondary fw-semibold mb-2">Feature view</p>
                                        <p class="mb-0">Show the component categories that matter before people click away.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="pb-4">
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <div class="row g-3 align-items-center">
                <div class="col-lg-4">
                    <p class="small text-uppercase text-body-secondary fw-semibold mb-0">BlazorExpress highlights specialized libraries instead of one oversized component catalog</p>
                </div>
                <div class="col-lg-8">
                    <div class="d-flex flex-wrap justify-content-lg-end gap-2">
                        <span class="badge text-bg-light border text-dark">Focused libraries</span>
                        <span class="badge text-bg-light border text-dark">Release callouts</span>
                        <span class="badge text-bg-light border text-dark">Live demos</span>
                        <span class="badge text-bg-light border text-dark">Docs links</span>
                        <span class="badge text-bg-light border text-dark">GitHub source</span>
                        <span class="badge text-bg-light border text-dark">NuGet packages</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="libraries" class="py-5">
    <div class="row justify-content-center text-center mb-4 mb-lg-5">
        <div class="col-xl-9">
            <span class="badge rounded-pill text-bg-dark mb-3">Library spotlight</span>
            <h2 class="display-6 fw-semibold mb-3">The main landing page now points visitors directly to the live BlazorExpress component libraries.</h2>
            <p class="lead text-body-secondary mb-0">Each library card summarizes the current release, notable capabilities, and the links developers actually need when evaluating the package.</p>
        </div>
    </div>
    <div class="row row-cols-1 row-cols-xl-2 g-4">
        <div class="col">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body p-4 p-lg-5">
                    <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                        <div>
                            <span class="badge rounded-pill text-bg-primary mb-2">Charting</span>
                            <h3 class="h2 mb-2">BlazorExpress.ChartJS</h3>
                            <p class="text-body-secondary mb-0">Fast, free, open-source Blazor charting components exposed through a focused site with docs, demos, and source.</p>
                        </div>
                        <span class="badge text-bg-light border text-dark">v1.2.1</span>
                    </div>
                    <div class="alert alert-primary" role="alert">
                        <div class="fw-semibold mb-1">New in v1.2.1</div>
                        Adds BarChart styling, LineChart features, and improved documentation.
                    </div>
                    <div class="list-group list-group-flush border rounded-3 mb-4">
                        <div class="list-group-item py-3">
                            <span class="fw-semibold d-block mb-1">Core chart set</span>
                            <span class="text-body-secondary">Bar, Bubble, Doughnut, Line, Pie, Polar Area, Radar, and Scatter charts.</span>
                        </div>
                        <div class="list-group-item py-3">
                            <span class="fw-semibold d-block mb-1">Utility support</span>
                            <span class="text-body-secondary">Color utilities and live demos help developers move from setup to production faster.</span>
                        </div>
                        <div class="list-group-item py-3">
                            <span class="fw-semibold d-block mb-1">Developer flow</span>
                            <span class="text-body-secondary">Docs, demos, GitHub, issues, discussions, and NuGet are all available from the library site.</span>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <a class="btn btn-primary" href="https://chartjs.blazorexpress.com/" target="_blank" rel="noreferrer">Visit site</a>
                        <a class="btn btn-outline-primary" href="https://chartjs.blazorexpress.com/docs/getting-started/introduction" target="_blank" rel="noreferrer">Docs</a>
                        <a class="btn btn-outline-primary" href="https://chartjs.blazorexpress.com/demos/bar-chart" target="_blank" rel="noreferrer">Demos</a>
                        <a class="btn btn-outline-primary" href="https://github.com/BlazorExpress/BlazorExpress.ChartJS" target="_blank" rel="noreferrer">GitHub</a>
                        <a class="btn btn-outline-primary" href="https://www.nuget.org/packages/BlazorExpress.ChartJS" target="_blank" rel="noreferrer">NuGet</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body p-4 p-lg-5">
                    <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                        <div>
                            <span class="badge rounded-pill text-bg-primary mb-2">Bulma UI</span>
                            <h3 class="h2 mb-2">BlazorExpress.Bulma</h3>
                            <p class="text-body-secondary mb-0">A focused Bulma-based component library for building responsive Blazor UI with form controls, dialogs, icons, and layout primitives.</p>
                        </div>
                        <span class="badge text-bg-light border text-dark">v1.1.0</span>
                    </div>
                    <div class="alert alert-primary" role="alert">
                        <div class="fw-semibold mb-1">New in v1.1.0</div>
                        New Dropdown, Navbar, NumberInput, and PdfViewer components, plus improved documentation.
                    </div>
                    <div class="list-group list-group-flush border rounded-3 mb-4">
                        <div class="list-group-item py-3">
                            <span class="fw-semibold d-block mb-1">UI building blocks</span>
                            <span class="text-body-secondary">Block, Box, Breadcrumb, Button, Delete Button, Dropdown, and Navbar support the page structure.</span>
                        </div>
                        <div class="list-group-item py-3">
                            <span class="fw-semibold d-block mb-1">Forms and dialogs</span>
                            <span class="text-body-secondary">DateInput, EnumInput, NumberInput, OTP Input, TextInput, and Confirm Dialog cover common interactions.</span>
                        </div>
                        <div class="list-group-item py-3">
                            <span class="fw-semibold d-block mb-1">Icon and document helpers</span>
                            <span class="text-body-secondary">Bootstrap Icons, Google Font Icons, and PdfViewer expand common app scenarios.</span>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <a class="btn btn-primary" href="https://bulma.blazorexpress.com/" target="_blank" rel="noreferrer">Visit site</a>
                        <a class="btn btn-outline-primary" href="https://bulma.blazorexpress.com/docs/getting-started/introduction" target="_blank" rel="noreferrer">Docs</a>
                        <a class="btn btn-outline-primary" href="https://bulma.blazorexpress.com/demos/skeletons" target="_blank" rel="noreferrer">Demos</a>
                        <a class="btn btn-outline-primary" href="https://github.com/BlazorExpress/BlazorExpress.Bulma" target="_blank" rel="noreferrer">GitHub</a>
                        <a class="btn btn-outline-primary" href="https://www.nuget.org/packages/BlazorExpress.Bulma/" target="_blank" rel="noreferrer">NuGet</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="releases" class="py-5">
    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body p-4">
                    <p class="small text-uppercase text-body-secondary fw-semibold mb-2">Current release</p>
                    <h3 class="h4 mb-3">ChartJS v1.2.1</h3>
                    <p class="text-body-secondary mb-4">The live site calls out styling improvements for BarChart, new LineChart capabilities, and better documentation coverage.</p>
                    <a class="btn btn-outline-primary" href="https://chartjs.blazorexpress.com/" target="_blank" rel="noreferrer">Open ChartJS site</a>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body p-4">
                    <p class="small text-uppercase text-body-secondary fw-semibold mb-2">Current release</p>
                    <h3 class="h4 mb-3">Bulma v1.1.0</h3>
                    <p class="text-body-secondary mb-4">The current Bulma release adds Dropdown, Navbar, NumberInput, and PdfViewer while tightening the documentation story.</p>
                    <a class="btn btn-outline-primary" href="https://bulma.blazorexpress.com/" target="_blank" rel="noreferrer">Open Bulma site</a>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card h-100 border-0 text-bg-dark bg-gradient shadow-lg">
                <div class="card-body p-4">
                    <p class="small text-uppercase fw-semibold text-white-50 mb-2">BlazorExpress model</p>
                    <h3 class="h4 mb-3">Focused libraries, clearer releases, simpler discovery.</h3>
                    <p class="text-white-50 mb-4">Instead of hiding separate libraries behind generic messaging, the landing page now surfaces what each library does, what just changed, and where developers should go next.</p>
                    <a class="btn btn-light" href="#features">See ecosystem features</a>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="features" class="py-5">
    <div class="row justify-content-center text-center mb-4 mb-lg-5">
        <div class="col-xl-8">
            <span class="badge rounded-pill text-bg-light border text-dark mb-3">Why this landing page works</span>
            <h2 class="display-6 fw-semibold mb-3">The main site speaks for the whole BlazorExpress ecosystem instead of a single framework baseline.</h2>
            <p class="lead text-body-secondary mb-0">The content is organized around the way developers evaluate component libraries: release quality, feature coverage, docs, demos, open source signals, and direct package access.</p>
        </div>
    </div>
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-4 g-4">
        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body p-4">
                    <p class="small text-uppercase text-body-secondary fw-semibold mb-2">Ecosystem hub</p>
                    <h3 class="h4">One brand, multiple focused libraries</h3>
                    <p class="text-body-secondary mb-0">Blazorexpress.com now acts as the entry point before visitors choose ChartJS, Bulma, or future libraries.</p>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body p-4">
                    <p class="small text-uppercase text-body-secondary fw-semibold mb-2">Release-first messaging</p>
                    <h3 class="h4">Show what changed immediately</h3>
                    <p class="text-body-secondary mb-0">Each highlighted library surfaces the current version and the latest capabilities without forcing users into the subsite first.</p>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body p-4">
                    <p class="small text-uppercase text-body-secondary fw-semibold mb-2">Developer navigation</p>
                    <h3 class="h4">Link to the real destinations</h3>
                    <p class="text-body-secondary mb-0">Docs, demos, GitHub repos, and NuGet packages are visible from the first scroll instead of hidden behind generic call to action buttons.</p>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body p-4">
                    <p class="small text-uppercase text-body-secondary fw-semibold mb-2">Bootstrap-only implementation</p>
                    <h3 class="h4">Gradient and layout without custom CSS</h3>
                    <p class="text-body-secondary mb-0">The landing page uses Bootstrap classes, Bootstrap gradients, and standard utility composition rather than local style overrides.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="resources" class="pt-2 pb-5">
    <div class="card border-0 text-bg-dark bg-gradient shadow-lg">
        <div class="card-body p-4 p-lg-5">
            <div class="row g-4 align-items-center">
                <div class="col-lg-8">
                    <span class="badge text-bg-light text-dark rounded-pill mb-3">Start here</span>
                    <h2 class="display-6 fw-semibold mb-3">Jump straight from the main site into the library that matches your UI stack.</h2>
                    <p class="mb-0 text-white-50">ChartJS covers focused charting scenarios. Bulma covers UI building blocks and form-heavy application surfaces. The landing page keeps both visible and easy to compare.</p>
                </div>
                <div class="col-lg-4">
                    <div class="d-grid gap-2">
                        <a class="btn btn-light btn-lg" href="https://chartjs.blazorexpress.com/" target="_blank" rel="noreferrer">Go to ChartJS</a>
                        <a class="btn btn-outline-light btn-lg" href="https://bulma.blazorexpress.com/" target="_blank" rel="noreferrer">Go to Bulma</a>
                        <a class="btn btn-outline-light btn-lg" href="#top">Back to top</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
