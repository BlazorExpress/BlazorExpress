@page
@model IndexModel
@{
    ViewData["Title"] = "Blazor Component Libraries";
}

<section id="top" class="landing-hero mb-4 mb-lg-5 fade-up">
    <div class="hero-shell rounded-5 p-4 p-lg-5 shadow-sm overflow-hidden">
        <div class="row g-4 align-items-center">
            <div class="col-lg-7">
                <span class="badge rounded-pill hero-badge mb-3">Built for modern Blazor teams</span>
                <h1 class="display-4 fw-semibold mb-3">We build focused Blazor libraries that are easy for customers to evaluate.</h1>
                <p class="lead text-body-secondary mb-4">BlazorExpress brings our active libraries into one landing page so teams can review the latest release, understand the use case, and move directly to docs, demos, GitHub, or NuGet.</p>
                <div class="d-flex flex-column flex-sm-row gap-3 mb-4">
                    <a class="btn btn-primary btn-lg px-4" href="#libraries">View libraries</a>
                    <a class="btn btn-outline-secondary btn-lg px-4" href="#releases">Latest releases</a>
                </div>
                <div class="row row-cols-1 row-cols-sm-3 g-3">
                    <div class="col">
                        <div class="mini-panel rounded-4 p-3 h-100">
                            <p class="small text-uppercase fw-semibold text-body-tertiary mb-2">Libraries</p>
                            <p class="h5 mb-0">2 active customer-ready packages</p>
                        </div>
                    </div>
                    <div class="col">
                        <div class="mini-panel rounded-4 p-3 h-100">
                            <p class="small text-uppercase fw-semibold text-body-tertiary mb-2">Focus</p>
                            <p class="h5 mb-0">Practical charts and UI components</p>
                        </div>
                    </div>
                    <div class="col">
                        <div class="mini-panel rounded-4 p-3 h-100">
                            <p class="small text-uppercase fw-semibold text-body-tertiary mb-2">Next step</p>
                            <p class="h5 mb-0">Open docs or demos</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4 p-lg-5">
                        <p class="small text-uppercase fw-semibold text-body-tertiary mb-2">Current lineup</p>
                        <h2 class="h3 mb-4">What we publish today.</h2>
                        <div class="d-grid gap-3">
                            <a class="simple-link-card text-decoration-none" href="https://chartjs.blazorexpress.com/" target="_blank" rel="noreferrer">
                                <span>
                                    <span class="d-block fw-semibold text-dark">BlazorExpress.ChartJS</span>
                                    <span class="small text-body-secondary">Our charting library for Blazor dashboards, reports, and data-heavy screens.</span>
                                </span>
                                <span class="badge text-bg-light border text-dark">v1.2.1</span>
                            </a>
                            <a class="simple-link-card text-decoration-none" href="https://bulma.blazorexpress.com/" target="_blank" rel="noreferrer">
                                <span>
                                    <span class="d-block fw-semibold text-dark">BlazorExpress.Bulma</span>
                                    <span class="small text-body-secondary">Our Bulma-based component library for forms, dialogs, and layout work.</span>
                                </span>
                                <span class="badge text-bg-light border text-dark">v1.1.0</span>
                            </a>
                        </div>
                        <hr class="my-4" />
                        <p class="text-body-secondary mb-0">We keep both libraries open source and connect every release to documentation, demos, package feeds, and source code.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="libraries" class="py-4 py-lg-5">
    <div class="row justify-content-center text-center mb-4">
        <div class="col-xl-8 fade-up fade-delay-1">
            <span class="badge rounded-pill text-bg-light border text-dark mb-3">Libraries</span>
            <h2 class="display-6 fw-semibold mb-3">These are the libraries we actively build and release.</h2>
            <p class="lead text-body-secondary mb-0">We keep this page short on purpose so customers can understand what each library is for, what changed recently, and where to go next.</p>
        </div>
    </div>
    <div class="row row-cols-1 row-cols-xl-2 g-4">
        <div class="col d-flex">
            <article class="card border-0 shadow-sm hover-lift w-100 fade-up fade-delay-1">
                <div class="card-body p-4 p-lg-5">
                    <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                        <div>
                            <span class="badge rounded-pill section-badge mb-2">Charting</span>
                            <h3 class="h2 mb-2">BlazorExpress.ChartJS</h3>
                            <p class="text-body-secondary mb-0">We built this library for Blazor apps that need clean chart components and solid data visualization without extra clutter.</p>
                        </div>
                        <span class="badge text-bg-light border text-dark">v1.2.1</span>
                    </div>
                    <div class="simple-detail-grid mb-4">
                        <div class="simple-detail rounded-4 p-3">
                            <p class="small text-uppercase fw-semibold text-body-tertiary mb-2">Includes</p>
                            <p class="mb-0">Bar, Line, Pie, Radar, Scatter.</p>
                        </div>
                        <div class="simple-detail rounded-4 p-3">
                            <p class="small text-uppercase fw-semibold text-body-tertiary mb-2">Latest update</p>
                            <p class="mb-0">In v1.2.1 we refined styling, added LineChart features, and tightened the documentation.</p>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <a class="btn btn-primary" href="https://chartjs.blazorexpress.com/" target="_blank" rel="noreferrer">Site</a>
                        <a class="btn btn-outline-primary" href="https://chartjs.blazorexpress.com/docs/getting-started/introduction" target="_blank" rel="noreferrer">Docs</a>
                        <a class="btn btn-outline-primary" href="https://chartjs.blazorexpress.com/demos/bar-chart" target="_blank" rel="noreferrer">Demos</a>
                        <a class="btn btn-outline-primary" href="https://github.com/BlazorExpress/BlazorExpress.ChartJS" target="_blank" rel="noreferrer">GitHub</a>
                        <a class="btn btn-outline-primary" href="https://www.nuget.org/packages/BlazorExpress.ChartJS" target="_blank" rel="noreferrer">NuGet</a>
                    </div>
                </div>
            </article>
        </div>
        <div class="col d-flex">
            <article class="card border-0 shadow-sm hover-lift w-100 fade-up fade-delay-2">
                <div class="card-body p-4 p-lg-5">
                    <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                        <div>
                            <span class="badge rounded-pill section-badge mb-2">UI</span>
                            <h3 class="h2 mb-2">BlazorExpress.Bulma</h3>
                            <p class="text-body-secondary mb-0">We built this library for Blazor apps that need dependable form controls, dialogs, layout helpers, and everyday UI pieces.</p>
                        </div>
                        <span class="badge text-bg-light border text-dark">v1.1.0</span>
                    </div>
                    <div class="simple-detail-grid mb-4">
                        <div class="simple-detail rounded-4 p-3">
                            <p class="small text-uppercase fw-semibold text-body-tertiary mb-2">Includes</p>
                            <p class="mb-0">Dropdown, Navbar, NumberInput, PdfViewer, Dialogs.</p>
                        </div>
                        <div class="simple-detail rounded-4 p-3">
                            <p class="small text-uppercase fw-semibold text-body-tertiary mb-2">Latest update</p>
                            <p class="mb-0">In v1.1.0 we added Dropdown, Navbar, NumberInput, and PdfViewer components.</p>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <a class="btn btn-primary" href="https://bulma.blazorexpress.com/" target="_blank" rel="noreferrer">Site</a>
                        <a class="btn btn-outline-primary" href="https://bulma.blazorexpress.com/docs/getting-started/introduction" target="_blank" rel="noreferrer">Docs</a>
                        <a class="btn btn-outline-primary" href="https://bulma.blazorexpress.com/demos/skeletons" target="_blank" rel="noreferrer">Demos</a>
                        <a class="btn btn-outline-primary" href="https://github.com/BlazorExpress/BlazorExpress.Bulma" target="_blank" rel="noreferrer">GitHub</a>
                        <a class="btn btn-outline-primary" href="https://www.nuget.org/packages/BlazorExpress.Bulma/" target="_blank" rel="noreferrer">NuGet</a>
                    </div>
                </div>
            </article>
        </div>
    </div>
</section>

<section id="releases" class="py-4 py-lg-5">
    <div class="row g-4 align-items-stretch">
        <div class="col-lg-4 d-flex">
            <div class="card border-0 shadow-sm w-100 fade-up fade-delay-1">
                <div class="card-body p-4">
                    <p class="small text-uppercase fw-semibold text-body-tertiary mb-2">Release</p>
                    <h3 class="h4 mb-3">ChartJS v1.2.1</h3>
                    <p class="text-body-secondary mb-0">We focused this release on cleaner styling, more LineChart options, and clearer docs.</p>
                </div>
            </div>
        </div>
        <div class="col-lg-4 d-flex">
            <div class="card border-0 shadow-sm w-100 fade-up fade-delay-2">
                <div class="card-body p-4">
                    <p class="small text-uppercase fw-semibold text-body-tertiary mb-2">Release</p>
                    <h3 class="h4 mb-3">Bulma v1.1.0</h3>
                    <p class="text-body-secondary mb-0">We expanded the library with new navigation, input, and viewer components for day-to-day UI work.</p>
                </div>
            </div>
        </div>
        <div class="col-lg-4 d-flex">
            <div class="card border-0 release-summary w-100 fade-up fade-delay-3">
                <div class="card-body p-4">
                    <p class="small text-uppercase fw-semibold mb-2">Today</p>
                    <h3 class="h4 mb-3">Two focused libraries. One clear starting point.</h3>
                    <p class="mb-0">This page reflects how we want customers to experience BlazorExpress: direct, useful, and easy to scan.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="features" class="pt-4 pb-5">
    <div class="simple-callout rounded-5 p-4 p-lg-5 fade-up fade-delay-2">
        <div class="row g-4 align-items-center">
            <div class="col-lg-8">
                <span class="badge rounded-pill text-bg-light border text-dark mb-3">Why this layout</span>
                <h2 class="display-6 fw-semibold mb-3">We want customers to understand the libraries in one quick pass.</h2>
                <p class="text-body-secondary mb-0">The goal is simple: help teams find the right library, confirm the release, and move into the docs or demo without friction.</p>
            </div>
            <div class="col-lg-4">
                <div class="d-grid gap-2">
                    <a class="btn btn-primary btn-lg" href="https://chartjs.blazorexpress.com/" target="_blank" rel="noreferrer">Open ChartJS</a>
                    <a class="btn btn-outline-primary btn-lg" href="https://bulma.blazorexpress.com/" target="_blank" rel="noreferrer">Open Bulma</a>
                    <a class="btn btn-outline-secondary btn-lg" href="#top">Back to top</a>
                </div>
            </div>
        </div>
    </div>
</section>
