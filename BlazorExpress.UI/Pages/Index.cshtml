@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<section id="top" class="hero-section py-4 py-lg-5">
    <div class="hero-gradient rounded-5 shadow-lg overflow-hidden fade-up">
        <div class="p-4 p-lg-5">
            <div class="row g-4 g-xl-5 align-items-center">
                <div class="col-lg-7">
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <img src="https://chartjs.blazorexpress.com/_content/BlazorExpress.ChartJS.Demo.RCL/icons/logo.png" alt="BlazorExpress logo" width="72" height="72" class="logo-float rounded-4 bg-white p-2 shadow-sm" />
                        <div>
                            <span class="badge rounded-pill text-bg-light text-primary mb-2">blazorexpress.com</span>
                            <p class="small text-uppercase fw-semibold text-white-50 mb-0">Focused, open-source component libraries for modern Blazor apps</p>
                        </div>
                    </div>
                    <h1 class="display-3 fw-bold text-white lh-sm mb-3">Simple, clean discovery for the BlazorExpress ecosystem.</h1>
                    <p class="lead text-white-50 mb-4">BlazorExpress highlights the important component libraries, their latest releases, the key features that matter, and the exact links developers need for docs, demos, GitHub, and NuGet.</p>
                    <div class="d-flex flex-column flex-sm-row gap-3 mb-4">
                        <a class="btn btn-light btn-lg px-4" href="#libraries">Explore libraries</a>
                        <a class="btn btn-outline-light btn-lg px-4" href="#releases">See latest releases</a>
                    </div>
                    <div class="row row-cols-1 row-cols-sm-3 g-3">
                        <div class="col">
                            <div class="hero-surface rounded-4 p-3 h-100">
                                <p class="small text-uppercase fw-semibold text-white-50 mb-2">Libraries</p>
                                <p class="h5 text-white mb-0">ChartJS and Bulma</p>
                            </div>
                        </div>
                        <div class="col">
                            <div class="hero-surface rounded-4 p-3 h-100">
                                <p class="small text-uppercase fw-semibold text-white-50 mb-2">Current versions</p>
                                <p class="h5 text-white mb-0">v1.2.1 and v1.1.0</p>
                            </div>
                        </div>
                        <div class="col">
                            <div class="hero-surface rounded-4 p-3 h-100">
                                <p class="small text-uppercase fw-semibold text-white-50 mb-2">Designed for</p>
                                <p class="h5 text-white mb-0">Docs, demos, and fast evaluation</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-5">
                    <div class="card border-0 shadow-sm hover-lift">
                        <div class="card-body p-4 p-lg-5">
                            <div class="d-flex justify-content-between align-items-start mb-4">
                                <div>
                                    <p class="small text-uppercase text-body-secondary fw-semibold mb-2">At a glance</p>
                                    <h2 class="h3 mb-0">Important libraries. Important features. No noise.</h2>
                                </div>
                                <span class="badge text-bg-success">Live</span>
                            </div>
                            <div class="list-group list-group-flush border rounded-4 mb-4">
                                <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3" href="https://chartjs.blazorexpress.com/" target="_blank" rel="noreferrer">
                                    <span>
                                        <span class="fw-semibold d-block">BlazorExpress.ChartJS</span>
                                        <span class="small text-body-secondary">Charts, dataset animation, localization, and utilities</span>
                                    </span>
                                    <span class="badge text-bg-primary">v1.2.1</span>
                                </a>
                                <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3" href="https://bulma.blazorexpress.com/" target="_blank" rel="noreferrer">
                                    <span>
                                        <span class="fw-semibold d-block">BlazorExpress.Bulma</span>
                                        <span class="small text-body-secondary">UI building blocks, forms, dialogs, icons, and layout</span>
                                    </span>
                                    <span class="badge text-bg-primary">v1.1.0</span>
                                </a>
                            </div>
                            <div class="row row-cols-1 row-cols-sm-2 g-3">
                                <div class="col">
                                    <div class="border rounded-4 p-3 h-100">
                                        <p class="small text-uppercase text-body-secondary fw-semibold mb-2">SEO friendly</p>
                                        <p class="mb-0">Clear headings, descriptive sections, and direct links to library destinations.</p>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="border rounded-4 p-3 h-100">
                                        <p class="small text-uppercase text-body-secondary fw-semibold mb-2">Mobile friendly</p>
                                        <p class="mb-0">The layout collapses cleanly to stacked cards and responsive live previews.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="pb-4">
    <div class="card border-0 shadow-sm fade-up fade-delay-1">
        <div class="card-body p-4 d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
            <p class="small text-uppercase text-body-secondary fw-semibold mb-0">Out-of-the-box design, simple and clean, with focused library messaging</p>
            <div class="d-flex flex-wrap gap-2">
                <span class="badge text-bg-light border text-dark">Minimal CSS</span>
                <span class="badge text-bg-light border text-dark">Subtle animation</span>
                <span class="badge text-bg-light border text-dark">Responsive layout</span>
                <span class="badge text-bg-light border text-dark">Live library previews</span>
                <span class="badge text-bg-light border text-dark">SEO metadata</span>
            </div>
        </div>
    </div>
</section>

<section id="libraries" class="py-5">
    <div class="row justify-content-center text-center mb-4 mb-lg-5 fade-up fade-delay-1">
        <div class="col-xl-9">
            <span class="badge rounded-pill text-bg-dark mb-3">Library highlights</span>
            <h2 class="display-6 fw-semibold mb-3">Two libraries, each shown with the release that matters and the features developers care about first.</h2>
            <p class="lead text-body-secondary mb-0">The page keeps the story tight: show the library, show the release, show the important components, and give direct links to the working docs and demos.</p>
        </div>
    </div>
    <div class="row row-cols-1 row-cols-xl-2 g-4">
        <div class="col d-flex">
            <article class="card border-0 shadow-sm hover-lift w-100 fade-up fade-delay-1">
                <div class="card-body p-4 p-lg-5">
                    <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                        <div>
                            <span class="badge rounded-pill text-bg-primary mb-2">Charting library</span>
                            <h3 class="h2 mb-2">BlazorExpress.ChartJS</h3>
                            <p class="text-body-secondary mb-0">Focused Blazor charting with a compact component set and strong demo-driven documentation.</p>
                        </div>
                        <span class="badge text-bg-light border text-dark">v1.2.1</span>
                    </div>
                    <div class="alert alert-primary" role="alert">
                        <div class="fw-semibold mb-1">New in v1.2.1</div>
                        BarChart styling improvements, new LineChart features, and better documentation.
                    </div>
                    <div class="preview-frame mb-4">
                        <div class="ratio ratio-4x3 bg-white">
                            <iframe src="https://chartjs.blazorexpress.com/demos/bar-chart" title="Live preview of the BlazorExpress.ChartJS bar chart demo page" loading="lazy"></iframe>
                        </div>
                    </div>
                    <div class="row row-cols-1 row-cols-sm-2 g-3 mb-4">
                        <div class="col">
                            <div class="border rounded-4 p-3 h-100">
                                <p class="small text-uppercase text-body-secondary fw-semibold mb-2">Important components</p>
                                <p class="mb-0">Bar, Line, Pie, Doughnut, Radar, Scatter.</p>
                            </div>
                        </div>
                        <div class="col">
                            <div class="border rounded-4 p-3 h-100">
                                <p class="small text-uppercase text-body-secondary fw-semibold mb-2">Key features</p>
                                <p class="mb-0">Stacked datasets, data labels, locale support, border radius, and animation delays.</p>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <a class="btn btn-primary" href="https://chartjs.blazorexpress.com/" target="_blank" rel="noreferrer">Visit site</a>
                        <a class="btn btn-outline-primary" href="https://chartjs.blazorexpress.com/docs/getting-started/introduction" target="_blank" rel="noreferrer">Docs</a>
                        <a class="btn btn-outline-primary" href="https://chartjs.blazorexpress.com/demos/bar-chart" target="_blank" rel="noreferrer">Demos</a>
                        <a class="btn btn-outline-primary" href="https://github.com/BlazorExpress/BlazorExpress.ChartJS" target="_blank" rel="noreferrer">GitHub</a>
                        <a class="btn btn-outline-primary" href="https://www.nuget.org/packages/BlazorExpress.ChartJS" target="_blank" rel="noreferrer">NuGet</a>
                    </div>
                </div>
            </article>
        </div>
        <div class="col d-flex">
            <article class="card border-0 shadow-sm hover-lift w-100 fade-up fade-delay-2">
                <div class="card-body p-4 p-lg-5">
                    <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                        <div>
                            <span class="badge rounded-pill text-bg-primary mb-2">Bulma UI library</span>
                            <h3 class="h2 mb-2">BlazorExpress.Bulma</h3>
                            <p class="text-body-secondary mb-0">A clean Bulma-based Blazor library for form-heavy apps, layout primitives, and practical interaction components.</p>
                        </div>
                        <span class="badge text-bg-light border text-dark">v1.1.0</span>
                    </div>
                    <div class="alert alert-primary" role="alert">
                        <div class="fw-semibold mb-1">New in v1.1.0</div>
                        New Dropdown, Navbar, NumberInput, and PdfViewer components, plus improved documentation.
                    </div>
                    <div class="preview-frame mb-4">
                        <div class="ratio ratio-4x3 bg-white">
                            <iframe src="https://bulma.blazorexpress.com/docs/getting-started/introduction" title="Live preview of the BlazorExpress.Bulma getting started documentation page" loading="lazy"></iframe>
                        </div>
                    </div>
                    <div class="row row-cols-1 row-cols-sm-2 g-3 mb-4">
                        <div class="col">
                            <div class="border rounded-4 p-3 h-100">
                                <p class="small text-uppercase text-body-secondary fw-semibold mb-2">Important components</p>
                                <p class="mb-0">Dropdown, Navbar, NumberInput, PdfViewer, Confirm Dialog, TextInput.</p>
                            </div>
                        </div>
                        <div class="col">
                            <div class="border rounded-4 p-3 h-100">
                                <p class="small text-uppercase text-body-secondary fw-semibold mb-2">Key features</p>
                                <p class="mb-0">Forms, icons, layout helpers, skeleton loading, dialogs, and responsive UI building blocks.</p>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <a class="btn btn-primary" href="https://bulma.blazorexpress.com/" target="_blank" rel="noreferrer">Visit site</a>
                        <a class="btn btn-outline-primary" href="https://bulma.blazorexpress.com/docs/getting-started/introduction" target="_blank" rel="noreferrer">Docs</a>
                        <a class="btn btn-outline-primary" href="https://bulma.blazorexpress.com/demos/skeletons" target="_blank" rel="noreferrer">Demos</a>
                        <a class="btn btn-outline-primary" href="https://github.com/BlazorExpress/BlazorExpress.Bulma" target="_blank" rel="noreferrer">GitHub</a>
                        <a class="btn btn-outline-primary" href="https://www.nuget.org/packages/BlazorExpress.Bulma/" target="_blank" rel="noreferrer">NuGet</a>
                    </div>
                </div>
            </article>
        </div>
    </div>
</section>

<section id="releases" class="py-5">
    <div class="row row-cols-1 row-cols-md-3 g-4">
        <div class="col d-flex">
            <div class="card border-0 shadow-sm w-100 hover-lift fade-up fade-delay-1">
                <div class="card-body p-4">
                    <p class="small text-uppercase text-body-secondary fw-semibold mb-2">Release snapshot</p>
                    <h3 class="h4 mb-3">ChartJS v1.2.1</h3>
                    <p class="text-body-secondary mb-0">BarChart styling improvements, added LineChart capabilities, and documentation work that reduces setup friction.</p>
                </div>
            </div>
        </div>
        <div class="col d-flex">
            <div class="card border-0 shadow-sm w-100 hover-lift fade-up fade-delay-2">
                <div class="card-body p-4">
                    <p class="small text-uppercase text-body-secondary fw-semibold mb-2">Release snapshot</p>
                    <h3 class="h4 mb-3">Bulma v1.1.0</h3>
                    <p class="text-body-secondary mb-0">Dropdown, Navbar, NumberInput, and PdfViewer strengthen the library for day-to-day business UI use cases.</p>
                </div>
            </div>
        </div>
        <div class="col d-flex">
            <div class="card border-0 text-bg-dark bg-gradient shadow-lg w-100 fade-up fade-delay-3">
                <div class="card-body p-4">
                    <p class="small text-uppercase fw-semibold text-white-50 mb-2">Landing page goal</p>
                    <h3 class="h4 mb-3">Simple ecosystem discovery with clean visual hierarchy.</h3>
                    <p class="text-white-50 mb-0">The design stays light, the copy stays focused, and the important component libraries get the top-level real estate.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="features" class="py-5">
    <div class="row justify-content-center text-center mb-4 mb-lg-5 fade-up fade-delay-1">
        <div class="col-xl-8">
            <span class="badge rounded-pill text-bg-light border text-dark mb-3">Why this works</span>
            <h2 class="display-6 fw-semibold mb-3">Only the important components and key features are surfaced on the first pass.</h2>
            <p class="lead text-body-secondary mb-0">The page is designed to help developers decide quickly: what the library is, what shipped recently, what components matter, and where to go next.</p>
        </div>
    </div>
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-4 g-4">
        <div class="col d-flex">
            <div class="card border-0 shadow-sm w-100 hover-lift fade-up fade-delay-1">
                <div class="card-body p-4">
                    <p class="small text-uppercase text-body-secondary fw-semibold mb-2">Simple by default</p>
                    <h3 class="h4">Clean sections and short decisions</h3>
                    <p class="text-body-secondary mb-0">Each section has one clear job instead of combining marketing copy, docs, and release notes into one block.</p>
                </div>
            </div>
        </div>
        <div class="col d-flex">
            <div class="card border-0 shadow-sm w-100 hover-lift fade-up fade-delay-2">
                <div class="card-body p-4">
                    <p class="small text-uppercase text-body-secondary fw-semibold mb-2">Mobile and tablet friendly</p>
                    <h3 class="h4">Stacks well on smaller screens</h3>
                    <p class="text-body-secondary mb-0">Cards stack vertically, previews stay inside responsive ratios, and CTAs remain easy to tap.</p>
                </div>
            </div>
        </div>
        <div class="col d-flex">
            <div class="card border-0 shadow-sm w-100 hover-lift fade-up fade-delay-3">
                <div class="card-body p-4">
                    <p class="small text-uppercase text-body-secondary fw-semibold mb-2">SEO ready</p>
                    <h3 class="h4">Useful headings and metadata</h3>
                    <p class="text-body-secondary mb-0">The layout uses meaningful headings, descriptive text, and shared metadata so the page is readable by users and search engines.</p>
                </div>
            </div>
        </div>
        <div class="col d-flex">
            <div class="card border-0 shadow-sm w-100 hover-lift fade-up fade-delay-3">
                <div class="card-body p-4">
                    <p class="small text-uppercase text-body-secondary fw-semibold mb-2">Minimal custom CSS</p>
                    <h3 class="h4">Only what Bootstrap does not provide</h3>
                    <p class="text-body-secondary mb-0">The custom stylesheet is limited to brand gradient, subtle motion, preview framing, and small visual refinements.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="pt-2 pb-5">
    <div class="card border-0 text-bg-dark bg-gradient shadow-lg fade-up fade-delay-2">
        <div class="card-body p-4 p-lg-5">
            <div class="row g-4 align-items-center">
                <div class="col-lg-8">
                    <span class="badge text-bg-light text-dark rounded-pill mb-3">Start with the right library</span>
                    <h2 class="display-6 fw-semibold mb-3">Use BlazorExpress as the entry point, then jump directly into the docs or demos that match your stack.</h2>
                    <p class="mb-0 text-white-50">ChartJS is for data-rich visualizations. Bulma is for practical UI building blocks, forms, and layout. The main site keeps both easy to discover.</p>
                </div>
                <div class="col-lg-4">
                    <div class="d-grid gap-2">
                        <a class="btn btn-light btn-lg" href="https://chartjs.blazorexpress.com/" target="_blank" rel="noreferrer">Open ChartJS</a>
                        <a class="btn btn-outline-light btn-lg" href="https://bulma.blazorexpress.com/" target="_blank" rel="noreferrer">Open Bulma</a>
                        <a class="btn btn-outline-light btn-lg" href="#top">Back to top</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
