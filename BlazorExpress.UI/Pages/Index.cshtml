                    <p class="small text-uppercase text-body-secondary fw-semibold mb-0">.NET major version targeted</p>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100 shadow-sm text-center">
                <div class="card-body p-4">
                    <p class="display-6 fw-bold mb-2">14</p>
