</section>

<section class="pt-2 pb-5">
    <div class="card border-0 text-bg-dark shadow-lg">
        <div class="card-body p-4 p-lg-5">
            <div class="row g-4 align-items-center">
                <div class="col-lg-8">
                    <span class="badge text-bg-light text-dark rounded-pill mb-3">Next step</span>
                    <h2 class="display-6 fw-semibold mb-3">Use this page as the base for your product story, then keep extending it with Bootstrap primitives.</h2>
                    <p class="mb-0 text-white-50">Pricing tables, testimonials, release notes, or product bundles can be added as new sections without changing the underlying styling rule.</p>
                </div>
                <div class="col-lg-4">
                    <div class="d-grid gap-2">
                        <a class="btn btn-light btn-lg" href="#top">Back to top</a>
