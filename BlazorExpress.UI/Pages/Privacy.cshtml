@page
@model PrivacyModel
@{
    ViewData["Title"] = "Privacy";
}

<section class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body p-4 p-lg-5">
                <h1 class="h2 mb-3">Privacy</h1>
                <p class="text-body-secondary mb-4">Replace this placeholder with the actual data collection, retention, and contact details for the application before release.</p>
                <div class="alert alert-light border mb-0" role="alert">
                    <h2 class="h5 mb-2">Suggested policy coverage</h2>
                    <ul class="mb-0">
                        <li>What user data is collected and why.</li>
                        <li>How long that data is retained.</li>
                        <li>Which third parties, if any, receive that data.</li>
                        <li>How users can request updates or deletion.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>
